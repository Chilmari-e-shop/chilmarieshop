{
  "rewrites": [
    {
      "source": "/__/auth/(.*)",
      "destination": "https://chilmarie-shop.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/admin",
      "destination": "/owner.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap-dynamic"
    },
    {
      "source": "/product-view/:id",
      "destination": "/api/product-seo?id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/app.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }
      ]
    },
    {
      "source": "/style.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }
      ]
    }
  ]
}
